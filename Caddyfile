# Con DOMAIN=midominio.com en .env → HTTPS automático.
# Sin DOMAIN → sirve en el puerto 80 por IP.
{$DOMAIN} {
	# El index.html NUNCA se cachea: si el navegador se queda con uno viejo,
	# carga un bundle JS obsoleto (p. ej. sin la pantalla de login) y la app
	# rompe tras cada despliegue. Los assets llevan hash en el nombre, así
	# que esos sí pueden cachearse para siempre.
	@html {
		path /
		path *.html
	}
	header @html Cache-Control "no-cache, must-revalidate"

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# n8n detrás del mismo dominio, en /n8n/. Va `handle` y NO `handle_path`
	# a propósito: handle_path corta el prefijo, y n8n está configurado con
	# N8N_PATH=/n8n/, o sea que espera recibirlo. Con el prefijo cortado
	# devolvía 404 en todo.
	handle /n8n/* {
		reverse_proxy n8n:5678
	}

	reverse_proxy backend:8000
}
