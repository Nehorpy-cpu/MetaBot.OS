# Copiar a .env y completar. El archivo .env NUNCA se versiona.

# --- Base de datos ---
# Desarrollo: sqlite. Producción: postgresql+psycopg://user:pass@host:5432/metabot
DATABASE_URL=sqlite:///./metabot.db

# --- Proveedores LLM (todos OpenAI-compatibles) ---
# Orden de fallback: se usa el primero que tenga API key configurada.
# NVIDIA NIM: generar key en https://build.nvidia.com
NVIDIA_API_KEY=
# Groq (free tier): https://console.groq.com
GROQ_API_KEY=
# OpenRouter (modelos free): https://openrouter.ai
OPENROUTER_API_KEY=

# --- WhatsApp Cloud API (Meta) ---
# Token permanente del system user de la app de Meta
WHATSAPP_TOKEN=
# Token arbitrario que vos elegís; se repite en la config del webhook en Meta
WHATSAPP_VERIFY_TOKEN=
# App secret de la app de Meta (Settings > Basic) para verificar firmas
WHATSAPP_APP_SECRET=
# El phone_number_id NO va acá: se guarda por empresa (multi-tenant)
# vía PATCH /api/companies/{id} {"wa_phone_number_id": "..."}

# --- Puente WhatsApp por QR (Baileys) ---
# Secreto compartido entre backend y bridge (inventá uno largo)
BRIDGE_SECRET=
# URL del bridge (default local)
BRIDGE_URL=http://localhost:3001

# --- App ---
TIMEZONE=America/Asuncion
# Producción (VPS): dominio para HTTPS automático de Caddy (ej. metabot.midominio.com)
# Vacío = servir por IP en puerto 80 (sin HTTPS; Meta webhook requiere dominio)
DOMAIN=
