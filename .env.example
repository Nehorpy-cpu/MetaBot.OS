# Copiar a .env y completar. El archivo .env NUNCA se versiona.

# --- Base de datos ---
# Desarrollo: sqlite. Producción: postgresql+psycopg://user:pass@host:5432/metabot
DATABASE_URL=sqlite:///./metabot.db

# --- Proveedores LLM (todos OpenAI-compatibles) ---
# Orden de fallback: se usa el primero que tenga API key configurada.
# NVIDIA NIM: generar key en https://build.nvidia.com
NVIDIA_API_KEY=
# Groq (free tier): https://console.groq.com
GROQ_API_KEY=
# OpenRouter (modelos free): https://openrouter.ai
OPENROUTER_API_KEY=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- App ---
TIMEZONE=America/Asuncion
